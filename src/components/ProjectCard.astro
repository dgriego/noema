---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
  eager?: boolean;
}
const { project, index, eager = false } = Astro.props;
const { title, category, location, cover, coverAlt } = project.data;
---

<a href={`/portfolio/${project.id}`} class="card">
  <div class="media">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[480, 800, 1200]}
      sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
  </div>
  <div class="meta">
    {index !== undefined && <span>({String(index + 1).padStart(2, '0')})</span>}
    <span>{category}</span>
    <span>{location}</span>
  </div>
  <h3>{title}</h3>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
  }
  .media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bg-alt);
    margin-bottom: 1.1rem;
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }
  .card:hover .media :global(img) {
    transform: scale(1.04);
  }
  .meta {
    display: flex;
    gap: 1rem;
    font: 600 0.68rem/1 var(--font-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--slate-mid);
    padding-bottom: 0.85rem;
    margin-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }
  .meta span:last-child {
    margin-left: auto;
  }
  h3 {
    margin: 0;
    transition: color 0.3s;
  }
  .card:hover h3 {
    color: var(--accent);
  }
</style>

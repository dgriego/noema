---
import { Image } from 'astro:assets';
import { nav, site, bookHref } from '../config/site';
import logo from '../assets/brand/logo.png';

const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="header">
  <div class="bar">
    <a href="/" class="logo" aria-label={`${site.name}, home`}>
      <Image src={logo} alt={site.name} width={132} densities={[1, 2]} loading="eager" />
    </a>

    <p class="tagline label">Spaces that hold beauty, story & meaning</p>

    <button class="toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Menu</span>
      <span class="burger" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={bookHref} class="btn btn--solid nav-cta">Book a Call</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.toggle');
  const header = document.querySelector('.header');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    header?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    height: 78px;
    padding-inline: var(--gutter);
  }
  .logo {
    justify-self: start;
    display: block;
  }
  .logo :global(img) {
    width: 132px;
    height: auto;
  }
  .tagline {
    margin: 0;
    font-size: 0.66rem;
    color: var(--accent);
    white-space: nowrap;
  }
  .nav {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    font: 500 0.78rem/1 var(--font-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--slate);
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
  }
  .nav ul a:hover,
  .nav ul a[aria-current='page'] {
    border-color: var(--accent);
    color: var(--accent);
  }
  .nav-cta {
    padding: 0.85em 1.3em;
    font-size: 0.68rem;
  }
  .toggle {
    display: none;
    background: none;
    border: 0;
    width: 44px;
    height: 44px;
    cursor: pointer;
    position: relative;
    justify-self: end;
  }
  .burger,
  .burger::before,
  .burger::after {
    position: absolute;
    left: 10px;
    width: 24px;
    height: 1.5px;
    background: var(--slate);
    transition: transform 0.25s;
  }
  .burger {
    top: 21px;
  }
  .burger::before,
  .burger::after {
    content: '';
    left: 0;
  }
  .burger::before {
    top: -7px;
  }
  .burger::after {
    top: 7px;
  }

  @media (max-width: 1180px) {
    .tagline {
      display: none;
    }
    .bar {
      grid-template-columns: auto 1fr;
    }
  }

  @media (max-width: 880px) {
    .toggle {
      display: block;
    }
    .nav {
      display: none;
      justify-self: stretch;
      position: absolute;
      top: 78px;
      left: 0;
      right: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
      padding: 1rem var(--gutter) 2rem;
    }
    .nav ul {
      flex-direction: column;
      gap: 0;
    }
    .nav ul a {
      display: block;
      font: 400 1.8rem/1.2 var(--font-body);
      letter-spacing: -0.02em;
      text-transform: none;
      padding-block: 0.7rem;
      border: 0;
      border-bottom: 1px solid var(--line);
    }
    .nav-cta {
      justify-content: center;
    }
    :global(.header.is-open) .nav {
      display: flex;
    }
    :global(.header.is-open) .burger {
      background: transparent;
    }
    :global(.header.is-open) .burger::before {
      transform: translateY(7px) rotate(45deg);
    }
    :global(.header.is-open) .burger::after {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>

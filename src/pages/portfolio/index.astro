---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Interior Design Portfolio"
  description="Explore Noema’s interior design portfolio: a NE Portland kitchen remodel, bedroom and nursery decorating, a Portland restaurant, and Santa Fe home styling."
>
  <section class="wrap page-head">
    <span class="eyebrow">Portfolio</span>
    <h1>Interiors with <em>color, texture,</em> and story.</h1>
    <p class="lead">A selection of residential, commercial, and styling projects from Portland and beyond.</p>
  </section>

  <section class="wrap grid" aria-labelledby="projects-h">
    <h2 id="projects-h" class="visually-hidden">Projects</h2>
    {projects.map((p, i) => <ProjectCard project={p} index={i} eager={i === 0} sizes="(max-width: 680px) 100vw, 50vw" />)}
  </section>

</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3.5rem 2.5rem;
    padding-bottom: var(--section);
  }
  @media (max-width: 680px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

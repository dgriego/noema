// Cloudflare Workers config. Workers Builds runs `npm run build` then `npx wrangler deploy`
// (for main) or `npx wrangler versions upload` (other branches, giving a preview URL).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name connected in Cloudflare (Workers & Pages → noema).
  "name": "noema",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // The site is served on noemainteriors.com, so the noema.<subdomain>.workers.dev copy is off.
  // Preview links still work because preview_urls is enabled separately.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /about serves about.html; /about.html and /about/ redirect to /about.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only the contact API runs code; every page is served straight from the asset cache.
    "run_worker_first": ["/api/*"]
  },
  // Where contact form inquiries are sent (forwarded by Cloudflare Email Routing).
  "vars": {
    "CONTACT_TO": "martha@noemainteriors.com"
  },
  // RESEND_API_KEY and CONTACT_FROM are set in the dashboard; keep_vars stops a deploy
  // from wiping them.
  "keep_vars": true,
  "observability": { "enabled": true }
}

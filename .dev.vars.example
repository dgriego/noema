# Copy to .dev.vars for local testing with `npm run cf:dev` (never commit .dev.vars).
# In production, set these in Cloudflare → Workers & Pages → noema → Settings → Variables and Secrets.
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_TO=you@example.com
# Optional once your domain is verified in Resend:
